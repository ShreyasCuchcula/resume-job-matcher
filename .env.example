# Copy this file to .env and adjust as needed. .env is git-ignored.

# SQLite by default so the app runs immediately after `pip install`.
# To switch to PostgreSQL: DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_matcher
DATABASE_URL=sqlite:///./resume_matcher.db

# Where uploaded resume files are stored on disk (server-generated {sha256}.{ext} names).
UPLOAD_DIR=./uploads

# Path to the scoring configuration (weights, thresholds, limits).
SCORING_CONFIG_PATH=./config/scoring.yaml
